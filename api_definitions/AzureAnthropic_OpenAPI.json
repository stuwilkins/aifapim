{
  "openapi": "3.0.1",
  "info": {
    "title": "Anthropic Service API",
    "description": "Anthropic Messages API proxied through Azure API Management. Based on https://platform.claude.com/docs/en/api/messages",
    "version": "2023-06-01"
  },
  "servers": [
    {
      "url": "https://aifapim.example.com"
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Create a Message",
        "description": "Send a structured list of input messages with text and/or image content, and the model will generate the next message in the conversation.",
        "operationId": "createMessage",
        "parameters": [
          {
            "name": "anthropic-version",
            "in": "header",
            "description": "API version (e.g. 2023-06-01)",
            "required": false,
            "schema": {
              "type": "string",
              "default": "2023-06-01"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication error"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {
              "retry-after": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "529": {
            "description": "API is temporarily overloaded"
          }
        }
      }
    },
    "/v1/messages/count_tokens": {
      "post": {
        "summary": "Count tokens in a Message",
        "description": "Count the number of tokens in a message, including tools, images, and documents, without creating it.",
        "operationId": "countTokens",
        "parameters": [
          {
            "name": "anthropic-version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "2023-06-01"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CountTokensRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenCount"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication error"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": ["model", "messages", "max_tokens"],
        "properties": {
          "model": {
            "type": "string",
            "description": "The model that will complete your prompt.",
            "example": "claude-sonnet-4-5"
          },
          "messages": {
            "type": "array",
            "description": "Input messages.",
            "items": {
              "$ref": "#/components/schemas/MessageParam"
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "The maximum number of tokens to generate before stopping.",
            "example": 1024
          },
          "system": {
            "description": "System prompt. Can be a string or an array of text blocks.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TextBlockParam"
                }
              }
            ]
          },
          "stop_sequences": {
            "type": "array",
            "description": "Custom text sequences that will cause the model to stop generating.",
            "items": {
              "type": "string"
            }
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to incrementally stream the response using server-sent events.",
            "default": false
          },
          "temperature": {
            "type": "number",
            "description": "Amount of randomness injected into the response. Range 0.0 to 1.0.",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "top_k": {
            "type": "integer",
            "description": "Only sample from the top K options for each subsequent token."
          },
          "top_p": {
            "type": "number",
            "description": "Use nucleus sampling.",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "tools": {
            "type": "array",
            "description": "Definitions of tools that the model may use.",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "thinking": {
            "$ref": "#/components/schemas/ThinkingConfig"
          }
        }
      },
      "CountTokensRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": {
            "type": "string",
            "description": "The model to use for token counting.",
            "example": "claude-sonnet-4-5"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageParam"
            }
          },
          "system": {
            "description": "System prompt.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TextBlockParam"
                }
              }
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "thinking": {
            "$ref": "#/components/schemas/ThinkingConfig"
          }
        }
      },
      "MessageParam": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant"],
            "description": "The role of the message author."
          },
          "content": {
            "description": "The content of the message. Can be a string or an array of content blocks.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentBlockParam"
                }
              }
            ]
          }
        }
      },
      "ContentBlockParam": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text", "image", "document", "tool_use", "tool_result"],
            "description": "The type of content block."
          },
          "text": {
            "type": "string",
            "description": "Text content (for type=text)."
          },
          "source": {
            "type": "object",
            "description": "Source data (for type=image or type=document).",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["base64", "url"]
              },
              "media_type": {
                "type": "string"
              },
              "data": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "id": {
            "type": "string",
            "description": "Tool use ID (for type=tool_use or type=tool_result)."
          },
          "name": {
            "type": "string",
            "description": "Tool name (for type=tool_use)."
          },
          "input": {
            "type": "object",
            "description": "Tool input (for type=tool_use).",
            "additionalProperties": true
          },
          "tool_use_id": {
            "type": "string",
            "description": "The tool_use block ID (for type=tool_result)."
          },
          "content": {
            "description": "Tool result content (for type=tool_result).",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "is_error": {
            "type": "boolean",
            "description": "Whether the tool result is an error (for type=tool_result)."
          },
          "cache_control": {
            "$ref": "#/components/schemas/CacheControl"
          }
        }
      },
      "TextBlockParam": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text"]
          },
          "text": {
            "type": "string"
          },
          "cache_control": {
            "$ref": "#/components/schemas/CacheControl"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique message identifier."
          },
          "type": {
            "type": "string",
            "enum": ["message"],
            "description": "Object type, always 'message'."
          },
          "role": {
            "type": "string",
            "enum": ["assistant"],
            "description": "Always 'assistant'."
          },
          "content": {
            "type": "array",
            "description": "Content blocks in the response.",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            }
          },
          "model": {
            "type": "string",
            "description": "The model that handled the request."
          },
          "stop_reason": {
            "type": "string",
            "enum": ["end_turn", "max_tokens", "stop_sequence", "tool_use", "refusal", "pause_turn"],
            "description": "The reason the model stopped generating.",
            "nullable": true
          },
          "stop_sequence": {
            "type": "string",
            "description": "The stop sequence that caused the model to stop, if applicable.",
            "nullable": true
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "ContentBlock": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["text", "tool_use", "thinking", "redacted_thinking"],
            "description": "The type of content block."
          },
          "text": {
            "type": "string",
            "description": "Generated text (for type=text)."
          },
          "id": {
            "type": "string",
            "description": "Tool use ID (for type=tool_use)."
          },
          "name": {
            "type": "string",
            "description": "Tool name (for type=tool_use)."
          },
          "input": {
            "type": "object",
            "description": "Tool input JSON (for type=tool_use).",
            "additionalProperties": true
          },
          "thinking": {
            "type": "string",
            "description": "Thinking content (for type=thinking)."
          },
          "signature": {
            "type": "string",
            "description": "Signature for thinking block verification (for type=thinking)."
          },
          "data": {
            "type": "string",
            "description": "Redacted thinking data (for type=redacted_thinking)."
          },
          "citations": {
            "type": "array",
            "description": "Citations for the content block.",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Number of input tokens consumed."
          },
          "output_tokens": {
            "type": "integer",
            "description": "Number of output tokens generated."
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "Number of input tokens used to create a cache entry."
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "Number of input tokens read from cache."
          },
          "service_tier": {
            "type": "string",
            "description": "The service tier used for the request."
          }
        }
      },
      "TokenCount": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "The number of input tokens."
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": ["name", "input_schema"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the tool."
          },
          "description": {
            "type": "string",
            "description": "Description of what the tool does."
          },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema object defining the expected parameters.",
            "additionalProperties": true
          },
          "cache_control": {
            "$ref": "#/components/schemas/CacheControl"
          }
        }
      },
      "ToolChoice": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["auto", "any", "tool", "none"],
            "description": "How the model should use tools."
          },
          "name": {
            "type": "string",
            "description": "The name of the tool to use (required when type=tool)."
          },
          "disable_parallel_tool_use": {
            "type": "boolean",
            "description": "Whether to disable parallel tool use."
          }
        }
      },
      "ThinkingConfig": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["enabled", "disabled", "adaptive"],
            "description": "Whether to enable extended thinking."
          },
          "budget_tokens": {
            "type": "integer",
            "description": "Maximum number of tokens for thinking (required when type=enabled)."
          },
          "display": {
            "type": "string",
            "enum": ["full", "summarized", "omitted"],
            "description": "Controls thinking display in the response."
          }
        }
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "An external identifier for the user associated with the request."
          }
        }
      },
      "CacheControl": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["ephemeral"],
            "description": "Cache control type."
          },
          "ttl": {
            "type": "integer",
            "description": "Time-to-live in seconds for the cache entry."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["error"]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "invalid_request_error",
                  "authentication_error",
                  "permission_error",
                  "not_found_error",
                  "rate_limit_error",
                  "api_error",
                  "overloaded_error"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "subscription-key",
        "in": "query"
      }
    }
  },
  "security": [
    {
      "apiKeyHeader": []
    },
    {
      "apiKeyQuery": []
    }
  ]
}
