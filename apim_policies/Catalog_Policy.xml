<policies>
  <inbound>
    <!-- The ip-filter allow-list below is substituted at deploy time by
         aifapim.bicep from the allowedClientIps parameter (see aifapim.bicepparam). -->
    <ip-filter action="allow">
      __ALLOWED_CLIENT_IPS__
    </ip-filter>
    <!-- Static return-response: no backend call is made. The catalog body is
         baked in at deploy time: aifapim.bicep replaces the sentinel in the
         set-body element below with the XML-escaped contents of
         model-catalog.json. The sentinel must appear only in set-body: it
         is replaced everywhere, and the catalog text is not valid inside an
         XML comment. -->
    <return-response>
      <set-status code="200" reason="OK" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>__CATALOG_JSON__</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
