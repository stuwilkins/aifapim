<policies>
    <inbound>
        <set-backend-service backend-id="aoai-primary-backend" />
        <!-- The ip-filter allow-list below is substituted at deploy time by
             aifapim.bicep from the allowedClientIps parameter (see aifapim.bicepparam). -->
        <ip-filter action="allow">
              __ALLOWED_CLIENT_IPS__
        </ip-filter>
        <base />
        <!-- Extract the deployment ID from the URL path after '/deployments/' -->
        <set-variable name="deploymentId" value="@(context.Request.Url.Path.Split('/').ElementAtOrDefault(1))" />
        <!-- Deployment name: the path segment after 'deployments'. Used to decide
             whether a failover to the secondary region can succeed. -->
        <set-variable name="deploymentName" value="@{
            var segs = context.Request.Url.Path.Split('/');
            for (int i = 0; i &lt; segs.Length - 1; i++) {
                if (segs[i] == &quot;deployments&quot;) { return segs[i + 1]; }
            }
            return &quot;&quot;;
        }" />
        <!-- Fail over to the secondary region only for models deployed there.
             __SECONDARY_MODELS__ is substituted at deploy time by aifapim.bicep
             as '|name|name|...' from modelDeployments[0]. -->
        <set-variable name="canFailover" value="@{
            var model = (string)context.Variables.GetValueOrDefault(&quot;deploymentName&quot;, &quot;&quot;);
            return model.Length &gt; 0 &amp;&amp; &quot;__SECONDARY_MODELS__&quot;.Contains(&quot;|&quot; + model + &quot;|&quot;);
        }" />
        <!-- Emit token metrics with the deployment ID as a dimension -->
        <azure-openai-token-limit tokens-per-minute="10000000" counter-key="@(context.Subscription.Id)" estimate-prompt-tokens="true" tokens-consumed-header-name="consumed-tokens" remaining-tokens-header-name="remaining-tokens" />
        <azure-openai-emit-token-metric>
            <dimension name="API ID" />
            <dimension name="Subscription ID" />
            <dimension name="Subscription Name" value="@(context.Subscription.Name)" />
            <dimension name="User ID" />
            <dimension name="Product ID" />
            <!-- Model dimension: AOAI clients pass the deployment name in the URL
                 path segment after /deployments/. The deploymentId variable is
                 set above. -->
            <dimension name="Model" value="@((string)context.Variables.GetValueOrDefault(&quot;deploymentId&quot;, &quot;&quot;))" />
            <dimension name="X-Forwarded-For" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Forwarded-For&quot;, context.Request.IpAddress))" />
        </azure-openai-emit-token-metric>
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    </inbound>
    <backend>
        <!-- 404 is not retried: it means the deployment does not exist, so the
             backend response is returned to the client unchanged. Failover to
             the secondary backend happens only when canFailover is set (the
             model is deployed in the secondary region); otherwise the retry
             goes back to the current backend. -->
        <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="5" interval="1" delta="1" max-interval="8" first-fast-retry="false">
            <!-- Failover logic below - uncomment to retry on secondary backend -->
            <choose>
                <when condition="@((context.Response.StatusCode == 429 || context.Response.StatusCode >= 500) &amp;&amp; context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;canFailover&quot;, false))">
                    <set-backend-service backend-id="aoai-secondary-backend" />
                </when>
            </choose>
            <forward-request buffer-request-body="true" timeout="__BACKEND_TIMEOUT__" />
        </retry>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
