<policies>
    <inbound>
        <set-backend-service backend-id="aoai-v1-messages-primary-backend" />
        <!-- The ip-filter allow-list below is substituted at deploy time by
             aifapim.bicep from the allowedClientIps parameter (see aifapim.bicepparam). -->
        <ip-filter action="allow">
              __ALLOWED_CLIENT_IPS__
        </ip-filter>
        <base />
        <!-- Extract the model name from the JSON request body. preserveContent=true
             keeps the body intact for the upstream call. Used as the Model dimension
             on the token metric below. -->
        <set-variable name="requestModel" value="@{
            try {
                var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
                return (string)body[&quot;model&quot;] ?? &quot;&quot;;
            } catch {
                return &quot;&quot;;
            }
        }" />
        <llm-token-limit tokens-per-minute="10000000" counter-key="@(context.Subscription.Id)" estimate-prompt-tokens="true" tokens-consumed-header-name="consumed-tokens" remaining-tokens-header-name="remaining-tokens" />
        <!-- Emit token metrics under a custom namespace, parallel to the
             Anthropic policy. Captures the Model dimension explicitly so that
             per-model token accounting is reliable in App Insights regardless
             of LlmLog ModelName behavior. -->
        <llm-emit-token-metric namespace="__METRIC_NAMESPACE__">
            <dimension name="API ID" />
            <dimension name="Subscription ID" />
            <dimension name="Subscription Name" value="@(context.Subscription.Name)" />
            <dimension name="User ID" />
            <dimension name="Product ID" />
            <dimension name="Model" value="@((string)context.Variables.GetValueOrDefault(&quot;requestModel&quot;, &quot;&quot;))" />
            <dimension name="X-Forwarded-For" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Forwarded-For&quot;, context.Request.IpAddress))" />
        </llm-emit-token-metric>
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    </inbound>
    <backend>
        <retry condition="@(context.Response.StatusCode == 404 || context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="5" interval="1" delta="1" max-interval="8" first-fast-retry="false">
            <choose>
                <when condition="@(context.Response.StatusCode == 404 || context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)">
                    <set-backend-service backend-id="aoai-v1-messages-secondary-backend" />
                </when>
            </choose>
            <forward-request buffer-request-body="true" timeout="__BACKEND_TIMEOUT__" />
        </retry>
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
